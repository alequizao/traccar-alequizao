diff --git a/src/main/java/org/traccar/api/resource/BillingResource.java b/src/main/java/org/traccar/api/resource/BillingResource.java
new file mode 100644
index 0000000..7bbfb74
--- /dev/null
+++ b/src/main/java/org/traccar/api/resource/BillingResource.java
@@ -0,0 +1,394 @@
+/*
+ * Cobrança por notificação · Desenvolvido por Alequizao <alequizao.dev@gmail.com>
+ * Licença Apache 2.0, como o Traccar.
+ */
+package org.traccar.api.resource;
+
+import jakarta.inject.Inject;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.DELETE;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.HeaderParam;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.PUT;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.billing.BillingStore;
+import org.traccar.model.Event;
+import org.traccar.model.User;
+import org.traccar.session.ConnectionManager;
+import org.traccar.storage.Storage;
+import org.traccar.storage.StorageException;
+import org.traccar.storage.query.Columns;
+import org.traccar.storage.query.Condition;
+import org.traccar.storage.query.Request;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.time.LocalDate;
+import java.time.temporal.ChronoUnit;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+@Path("billing")
+@Produces(MediaType.APPLICATION_JSON)
+@Consumes(MediaType.APPLICATION_JSON)
+public class BillingResource extends BaseResource {
+
+    private static final org.slf4j.Logger LOGGER = org.slf4j.LoggerFactory.getLogger(BillingResource.class);
+
+    public static final String TYPE_BILLING = "cobranca";
+
+    public static class Notice {
+        public long userId;
+        public String message;
+    }
+
+    @Inject
+    private Storage storage;
+
+    @Inject
+    private ConnectionManager connectionManager;
+
+    @Inject
+    private BillingStore store;
+
+    public static class AccountRequest {
+        public String dueDate;
+        public Double amount;
+        public String paidOn;
+        public String payLink;
+        public String pixCode;
+    }
+
+    public static class Settings {
+        public String payLink;
+        public String pixCode;
+    }
+
+    private static final int UPCOMING = 6;
+
+    /**
+     * Tells one customer's connected apps that their billing changed ("kind": notice, paid or update). Notices and
+     * payments are stored so an offline phone still gets them; plain updates are only delivered live.
+     * Returns false when the customer has no vehicle to carry the event.
+     */
+    private boolean push(long userId, String kind, String message, boolean keep) {
+        var event = new Event(TYPE_BILLING, 0); // live only: never written to tc_events (reports would leak it)
+        event.set("userId", String.valueOf(userId));
+        event.set("kind", kind);
+        if (message != null) {
+            String text = message.length() > 2000 ? message.substring(0, 2000) : message;
+            event.set("message", text);
+            if (keep) {
+                // an offline phone fetches it later from /billing/notices (only the owner can read them)
+                event.set("noticeId", store.addNotice(userId, kind, text));
+            }
+        }
+        connectionManager.updateEvent(true, userId, event);
+        return true;
+    }
+
+    /** A failed push must never undo or hide a billing change that was already saved. */
+    private void pushQuietly(long userId, String kind, String message, boolean keep) {
+        try {
+            push(userId, kind, message, keep);
+        } catch (Exception e) {
+            LOGGER.warn("Billing push failed", e);
+        }
+    }
+
+    /** Account as shown to its owner: status, upcoming dues (monthly) and payments received. */
+    private Map<String, Object> view(BillingStore.Account account, boolean withLink) {
+        var result = new LinkedHashMap<String, Object>();
+        var today = BillingStore.today();
+        result.put("today", today.toString());
+        if (account == null || account.dueDate == null) {
+            result.put("active", false);
+            result.put("payments", account == null ? List.of() : paymentsNewestFirst(account));
+            result.put("upcoming", List.of());
+            result.put("payLink", account != null && account.payLink != null ? account.payLink : store.payLink());
+            result.put("ownPayLink", account == null ? null : account.payLink);
+            result.put("proof", account == null ? null : account.proof);
+            result.put("pixCode", account != null && account.pixCode != null ? account.pixCode : store.pixCode());
+            result.put("ownPixCode", account == null ? null : account.pixCode);
+            return result;
+        }
+        var due = LocalDate.parse(account.dueDate);
+        long days = ChronoUnit.DAYS.between(today, due);
+        result.put("active", true);
+        result.put("dueDate", account.dueDate);
+        result.put("amount", account.amount);
+        result.put("daysToDue", days);
+        result.put("status", days < 0 ? "overdue" : days == 0 ? "dueToday" : days <= 5 ? "dueSoon" : "ok");
+        result.put("lastNotice", account.lastNotice);
+        var upcoming = new ArrayList<Map<String, Object>>();
+        for (int i = 0; i < UPCOMING; i++) {
+            var item = new LinkedHashMap<String, Object>();
+            item.put("due", BillingStore.addMonths(due, i, account.anchorDay).toString());
+            item.put("amount", account.amount);
+            upcoming.add(item);
+        }
+        result.put("upcoming", upcoming);
+        result.put("payments", paymentsNewestFirst(account));
+        result.put("payLink", account.payLink != null ? account.payLink : store.payLink());
+        result.put("ownPayLink", account.payLink);
+        result.put("proof", account.proof);
+        result.put("pixCode", account.pixCode != null ? account.pixCode : store.pixCode());
+        result.put("ownPixCode", account.pixCode);
+        return result;
+    }
+
+    private List<BillingStore.Payment> paymentsNewestFirst(BillingStore.Account account) {
+        var list = new ArrayList<>(account.payments);
+        java.util.Collections.reverse(list);
+        return list;
+    }
+
+    /** The logged user's own account (read only). */
+    @GET
+    @Path("me")
+    public Map<String, Object> me() {
+        return view(store.get(getUserId()), true);
+    }
+
+    /** Every account, for the administrator. */
+    @GET
+    @Path("accounts")
+    public Map<String, Object> accounts() throws StorageException {
+        permissionsService.checkAdmin(getUserId());
+        var result = new LinkedHashMap<String, Object>();
+        var existing = new java.util.HashSet<Long>();
+        storage.getObjects(User.class, new Request(new Columns.Include("id")))
+                .forEach(user -> existing.add(user.getId()));
+        store.purgeOrphans(existing); // deleted customers leave nothing behind
+        var list = new LinkedHashMap<String, Object>();
+        store.all().forEach((id, account) -> {
+            try {
+                list.put(id, view(account, false));
+            } catch (RuntimeException e) {
+                LOGGER.warn("Billing account {} could not be shown", id, e);
+            }
+        });
+        result.put("accounts", list);
+        result.put("payLink", store.payLink());
+        result.put("pixCode", store.pixCode());
+        return result;
+    }
+
+    @PUT
+    @Path("accounts/{userId}")
+    public Map<String, Object> configure(@PathParam("userId") long userId, AccountRequest request)
+            throws StorageException {
+        permissionsService.checkAdmin(getUserId());
+        requireUser(userId);
+        if (request == null) {
+            throw new WebApplicationException(Response.status(Response.Status.BAD_REQUEST).build());
+        }
+        try {
+            var account = store.configure(userId, request.dueDate, request.amount, request.payLink, request.pixCode);
+            pushQuietly(userId, "update", null, false);
+            return view(account, false);
+        } catch (java.time.DateTimeException | IllegalArgumentException | NullPointerException e) {
+            throw new WebApplicationException(Response.status(Response.Status.BAD_REQUEST).build());
+        }
+    }
+
+    @POST
+    @Path("accounts/{userId}/pay")
+    public Map<String, Object> pay(@PathParam("userId") long userId, AccountRequest request)
+            throws StorageException {
+        permissionsService.checkAdmin(getUserId());
+        try {
+            var account = store.pay(userId, request == null ? null : request.amount,
+                    request == null ? null : request.paidOn);
+            pushQuietly(userId, "paid", "Pagamento recebido! Obrigado."
+                    + (account.dueDate == null ? "" : " Próximo vencimento: " + account.dueDate.substring(8, 10) + "/"
+                    + account.dueDate.substring(5, 7) + "/" + account.dueDate.substring(0, 4) + "."), true);
+            return view(account, false);
+        } catch (IllegalStateException e) {
+            throw new WebApplicationException(Response.status(Response.Status.CONFLICT).build());
+        } catch (java.time.DateTimeException | IllegalArgumentException e) {
+            throw new WebApplicationException(Response.status(Response.Status.BAD_REQUEST).build());
+        }
+    }
+
+    @POST
+    @Path("accounts/{userId}/undo")
+    public Map<String, Object> undo(@PathParam("userId") long userId) throws StorageException {
+        permissionsService.checkAdmin(getUserId());
+        try {
+            var account = store.undo(userId);
+            pushQuietly(userId, "update", null, false);
+            return view(account, false);
+        } catch (IllegalStateException e) {
+            throw new WebApplicationException(Response.status(Response.Status.CONFLICT).build());
+        }
+    }
+
+    @PUT
+    @Path("settings")
+    public Map<String, Object> settings(Settings settings) throws StorageException {
+        permissionsService.checkAdmin(getUserId());
+        try {
+            if (settings != null && settings.payLink != null) {
+                store.setPayLink(settings.payLink);
+            }
+            if (settings != null && settings.pixCode != null) {
+                store.setPixCode(settings.pixCode);
+            }
+        } catch (IllegalArgumentException e) {
+            throw new WebApplicationException(Response.status(Response.Status.BAD_REQUEST).build());
+        }
+        return Map.of("payLink", store.payLink(), "pixCode", store.pixCode());
+    }
+
+    /**
+     * Sends a billing notice to one user (administrators only). It is stored as an event of type "cobranca" on one
+     * of the user's vehicles, so the user's app shows it right away if connected, or recovers it later.
+     */
+    @POST
+    @Path("notify")
+    public Map<String, Object> notify(Notice notice) throws StorageException {
+        permissionsService.checkAdmin(getUserId());
+        if (notice == null || notice.userId <= 0 || notice.message == null || notice.message.isBlank()) {
+            throw new WebApplicationException(Response.status(Response.Status.BAD_REQUEST).build());
+        }
+        requireUser(notice.userId);
+        push(notice.userId, "notice", notice.message, true);
+        store.noticeSent(notice.userId);
+        return new LinkedHashMap<>(Map.of("sent", true));
+    }
+
+    private void requireUser(long userId) throws StorageException {
+        if (userId <= 0 || storage.getObject(User.class, new Request(
+                new Columns.Include("id"), new Condition.Equals("id", userId))) == null) {
+            throw new WebApplicationException(Response.status(Response.Status.NOT_FOUND).build());
+        }
+    }
+
+    /** The logged user's own pending notices (billing messages kept up to 7 days), newest last. */
+    @GET
+    @Path("notices")
+    public Map<String, Object> notices() {
+        return Map.of("notices", store.notices(getUserId()));
+    }
+
+    private static final int MAX_PROOF = 5 * 1024 * 1024;
+
+    private static String proofType(byte[] b) {
+        if (b.length > 3 && (b[0] & 0xFF) == 0xFF && (b[1] & 0xFF) == 0xD8 && (b[2] & 0xFF) == 0xFF) {
+            return "image/jpeg";
+        }
+        if (b.length > 8 && (b[0] & 0xFF) == 0x89 && b[1] == 'P' && b[2] == 'N' && b[3] == 'G') {
+            return "image/png";
+        }
+        if (b.length > 5 && b[0] == '%' && b[1] == 'P' && b[2] == 'D' && b[3] == 'F') {
+            return "application/pdf";
+        }
+        if (b.length > 12 && b[0] == 'R' && b[1] == 'I' && b[2] == 'F' && b[3] == 'F'
+                && b[8] == 'W' && b[9] == 'E' && b[10] == 'B' && b[11] == 'P') {
+            return "image/webp";
+        }
+        return null;
+    }
+
+    /** Tells every administrator's open screens that something changed (live only, nothing stored). */
+    private void pingAdmins(long fromUserId) {
+        try {
+            for (var admin : storage.getObjects(User.class, new Request(
+                    new Columns.Include("id"), new Condition.Equals("administrator", true)))) {
+                var event = new Event(TYPE_BILLING, 0);
+                event.set("userId", String.valueOf(fromUserId));
+                event.set("kind", "proof");
+                connectionManager.updateEvent(true, admin.getId(), event);
+            }
+        } catch (Exception e) {
+            LOGGER.warn("Admin ping failed", e);
+        }
+    }
+
+    /**
+     * The customer attaches the payment receipt (image or PDF up to 5 MB, raw bytes in the body). It is kept only
+     * until the administrator confirms the payment, which deletes it.
+     */
+    @POST
+    @Path("proof")
+    @Consumes(MediaType.WILDCARD)
+    public Map<String, Object> uploadProof(@HeaderParam("X-File-Name") String name, InputStream body)
+            throws IOException {
+        byte[] bytes = body.readNBytes(MAX_PROOF + 1);
+        if (bytes.length > MAX_PROOF) {
+            throw new WebApplicationException(Response.status(Response.Status.REQUEST_ENTITY_TOO_LARGE).build());
+        }
+        String type = proofType(bytes);
+        if (type == null) {
+            throw new WebApplicationException(Response.status(Response.Status.UNSUPPORTED_MEDIA_TYPE).build());
+        }
+        try {
+            String fileName;
+            try {
+                fileName = name == null ? null : java.net.URLDecoder.decode(
+                        name.replace("+", "%2B"), java.nio.charset.StandardCharsets.UTF_8);
+            } catch (IllegalArgumentException e) {
+                fileName = null; // malformed %-escape: fall back to a generic name
+            }
+            var account = store.saveProof(getUserId(), bytes, fileName, type);
+            pingAdmins(getUserId());
+            return view(account, true);
+        } catch (IllegalStateException e) {
+            throw new WebApplicationException(Response.status(Response.Status.CONFLICT).build());
+        }
+    }
+
+    /** The owner removes their own receipt. */
+    @DELETE
+    @Path("proof")
+    public Map<String, Object> removeOwnProof() {
+        var account = store.removeProof(getUserId());
+        pingAdmins(getUserId());
+        return view(account, true);
+    }
+
+    /** Receipt file: the administrator sees anyone's, a customer only their own. */
+    @GET
+    @Path("proof/{userId}")
+    @Produces(MediaType.WILDCARD)
+    public Response proofFile(@PathParam("userId") long userId) throws StorageException, IOException {
+        if (userId != getUserId()) {
+            permissionsService.checkAdmin(getUserId());
+        }
+        var proof = store.proof(userId);
+        byte[] bytes = store.proofBytes(userId);
+        if (proof == null || bytes == null) {
+            throw new WebApplicationException(Response.Status.NOT_FOUND);
+        }
+        boolean image = proof.type.startsWith("image/");
+        return Response.ok(bytes, proof.type)
+                .header("Cache-Control", "no-store")
+                .header("X-Content-Type-Options", "nosniff")
+                .header("Content-Security-Policy", "default-src 'none'; sandbox")
+                .header("Content-Disposition", (image ? "inline" : "attachment") + "; filename*=UTF-8''"
+                        + java.net.URLEncoder.encode(proof.name, java.nio.charset.StandardCharsets.UTF_8)
+                        .replace("+", "%20"))
+                .build();
+    }
+
+    /** The administrator rejects/removes a receipt without confirming the payment. */
+    @DELETE
+    @Path("proof/{userId}")
+    public Map<String, Object> removeProof(@PathParam("userId") long userId) throws StorageException {
+        permissionsService.checkAdmin(getUserId());
+        var account = store.removeProof(userId);
+        pushQuietly(userId, "update", null, false);
+        return view(account, false);
+    }
+
+}
