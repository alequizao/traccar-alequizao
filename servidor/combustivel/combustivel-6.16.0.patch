@@ -0,0 +1,450 @@
+/*
+ * Cobrança dos clientes · Desenvolvido por Alequizao <alequizao.dev@gmail.com>
+ * Licença Apache 2.0, como o Traccar.
+ */
+package org.traccar.billing;
+
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.traccar.config.Config;
+import org.traccar.config.Keys;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.UUID;
+
+/**
+ * Billing data kept in a file of its own (data/billing.json), outside the user records, so that customers can
+ * read their own account but never write it: only the administrator endpoints change it.
+ */
+@Singleton
+public class BillingStore {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(BillingStore.class);
+    public static final ZoneId ZONE = ZoneId.of("America/Maceio");
+
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    public static class Payment {
+        public String id;
+        public String paidOn;      // yyyy-MM-dd, day the payment was registered as received
+        public String due;         // yyyy-MM-dd, the due date it settled
+        public Double amount;
+        public String registeredAt;
+    }
+
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    public static class Proof {
+        public String file;        // file name inside data/billing-proofs
+        public String name;        // name the customer gave it
+        public String type;        // image/jpeg, image/png, image/webp or application/pdf
+        public long size;
+        public String uploadedAt;  // ISO instant
+    }
+
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    public static class Account {
+        public String dueDate;     // next unpaid due date (yyyy-MM-dd), null = no billing
+        public int anchorDay;      // day of the month the customer pays on (31 stays 31 after a short month)
+        public Double amount;      // monthly amount
+        public String lastNotice;  // ISO instant of the last push sent
+        public String payLink;     // payment link of this customer (falls back to the general one)
+        public String pixCode;     // Pix "copia e cola" of this customer (falls back to the general one)
+        public Proof proof;        // payment receipt sent by the customer; deleted when the payment is confirmed
+        public List<Payment> payments = new ArrayList<>();
+    }
+
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    public static class Notice {
+        public String id;
+        public String kind;        // notice | paid
+        public String message;
+        public String createdAt;   // ISO instant
+    }
+
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    public static class Data {
+        public Map<String, Object> settings = new TreeMap<>();
+        public Map<String, Account> accounts = new TreeMap<>();
+        public Map<String, List<Notice>> notices = new TreeMap<>();
+    }
+
+    private final ObjectMapper mapper = new ObjectMapper();
+    private final Path file;
+    private final Path proofDir;
+    private Data data = new Data();
+
+    @Inject
+    public BillingStore(Config config) {
+        this.file = Path.of(config.getString(Keys.FUEL_CACHE, "data/fuel.json"))
+                .toAbsolutePath().resolveSibling("billing.json");
+        this.proofDir = file.resolveSibling("billing-proofs");
+        load();
+    }
+
+    private boolean loadFailed;
+
+    private synchronized void load() {
+        if (!Files.exists(file)) {
+            return;
+        }
+        try {
+            data = mapper.readValue(Files.readString(file), Data.class);
+        } catch (Exception e) {
+            LOGGER.error("Billing data corrupted in {}, trying the backup", file, e);
+            try {
+                data = mapper.readValue(Files.readString(file.resolveSibling("billing.json.bak")), Data.class);
+                Files.move(file, file.resolveSibling("billing.json.corrupt-" + System.currentTimeMillis()));
+                LOGGER.warn("Billing data restored from billing.json.bak");
+            } catch (Exception second) {
+                loadFailed = true; // never overwrite what could not be read
+                LOGGER.error("Billing backup unusable too: writes are refused until fixed", second);
+            }
+        }
+    }
+
+    private void save() {
+        if (loadFailed) {
+            throw new IllegalStateException("Billing data could not be loaded; refusing to overwrite it");
+        }
+        try {
+            var temp = file.resolveSibling("billing.json.tmp");
+            Files.writeString(temp, mapper.writerWithDefaultPrettyPrinter().writeValueAsString(data));
+            if (Files.exists(file)) {
+                Files.copy(file, file.resolveSibling("billing.json.bak"), StandardCopyOption.REPLACE_EXISTING);
+            }
+            Files.move(temp, file, StandardCopyOption.REPLACE_EXISTING);
+        } catch (IOException e) {
+            throw new IllegalStateException("Billing data not saved", e);
+        }
+    }
+
+    public static LocalDate today() {
+        return LocalDate.now(ZONE);
+    }
+
+    public synchronized String payLink() {
+        var link = data.settings.get("payLink");
+        return link == null ? "" : link.toString();
+    }
+
+    /** Only https links (or empty): the customer opens it with one tap, so no javascript:/intent: schemes. */
+    public static String checkLink(String link) {
+        if (link == null || link.isBlank()) {
+            return "";
+        }
+        var value = link.trim();
+        if (value.length() > 2000 || !value.regionMatches(true, 0, "https://", 0, 8)) {
+            throw new IllegalArgumentException("invalid link");
+        }
+        return value;
+    }
+
+    public static String checkPix(String code) {
+        if (code == null || code.isBlank()) {
+            return "";
+        }
+        var value = code.trim();
+        if (value.length() > 1000) {
+            throw new IllegalArgumentException("invalid pix");
+        }
+        return value;
+    }
+
+    public static Double checkAmount(Double amount) {
+        if (amount == null) {
+            return null;
+        }
+        if (!Double.isFinite(amount) || amount <= 0 || amount >= 1e7) {
+            throw new IllegalArgumentException("invalid amount");
+        }
+        return Math.round(amount * 100) / 100.0;
+    }
+
+    public static LocalDate checkDate(String date) {
+        var parsed = LocalDate.parse(date); // yyyy-MM-dd
+        if (parsed.getYear() < 2020 || parsed.getYear() > 2100) {
+            throw new IllegalArgumentException("invalid date");
+        }
+        return parsed;
+    }
+
+    public synchronized void setPayLink(String link) {
+        data.settings.put("payLink", checkLink(link));
+        save();
+    }
+
+    public synchronized String pixCode() {
+        var code = data.settings.get("pixCode");
+        return code == null ? "" : code.toString();
+    }
+
+    public synchronized void setPixCode(String code) {
+        data.settings.put("pixCode", checkPix(code));
+        save();
+    }
+
+    public synchronized Account get(long userId) {
+        return copy(data.accounts.get(String.valueOf(userId)));
+    }
+
+    public synchronized Map<String, Account> all() {
+        var result = new TreeMap<String, Account>();
+        data.accounts.forEach((k, v) -> result.put(k, copy(v)));
+        return result;
+    }
+
+    /** Sets the due date and the monthly amount (null clears them). Payments are kept. */
+    public synchronized Account configure(
+            long userId, String dueDate, Double amount, String payLink, String pixCode) {
+        String due = null;
+        if (dueDate != null && !dueDate.isEmpty()) {
+            due = checkDate(dueDate).toString();
+        }
+        Double value = checkAmount(amount);
+        String link = checkLink(payLink);
+        String pix = checkPix(pixCode);
+        var account = data.accounts.computeIfAbsent(String.valueOf(userId), k -> new Account());
+        account.dueDate = due;
+        account.anchorDay = due == null ? 0 : LocalDate.parse(due).getDayOfMonth();
+        account.amount = value;
+        account.payLink = link.isEmpty() ? null : link;
+        account.pixCode = pix.isEmpty() ? null : pix;
+        if (due == null) {
+            deleteProofFile(account);
+            account.proof = null;
+        }
+        save();
+        return copy(account);
+    }
+
+    /** Registers the current due date as paid and moves the due date one month ahead. */
+    public synchronized Account pay(long userId, Double amount, String paidOn) {
+        var account = data.accounts.get(String.valueOf(userId));
+        if (account == null || account.dueDate == null) {
+            throw new IllegalStateException("no due date");
+        }
+        var next = addMonths(LocalDate.parse(account.dueDate), 1, account.anchorDay);
+        var payment = new Payment();
+        payment.id = UUID.randomUUID().toString().substring(0, 8);
+        payment.due = account.dueDate;
+        payment.paidOn = paidOn == null || paidOn.isEmpty() ? today().toString() : checkPaidOn(paidOn);
+        payment.amount = amount != null ? checkAmount(amount) : account.amount;
+        payment.registeredAt = java.time.Instant.now().toString();
+        account.payments.add(payment);
+        account.dueDate = next.toString();
+        deleteProofFile(account); // receipt confirmed: the proof is no longer needed
+        account.proof = null;
+        save();
+        return copy(account);
+    }
+
+    /** Undoes the last payment: it is removed and the due date goes back to the one it had settled. */
+    public synchronized Account undo(long userId) {
+        var account = data.accounts.get(String.valueOf(userId));
+        if (account == null || account.payments.isEmpty()) {
+            throw new IllegalStateException("no payment");
+        }
+        var last = account.payments.get(account.payments.size() - 1);
+        var expected = addMonths(LocalDate.parse(last.due), 1, account.anchorDay).toString();
+        if (account.dueDate != null && !account.dueDate.equals(expected)) {
+            throw new IllegalStateException("due date was changed after the payment");
+        }
+        account.payments.remove(account.payments.size() - 1);
+        account.dueDate = last.due;
+        save();
+        return copy(account);
+    }
+
+    private void deleteProofFile(Account account) {
+        if (account.proof != null && account.proof.file != null) {
+            try {
+                Files.deleteIfExists(proofDir.resolve(account.proof.file));
+            } catch (IOException e) {
+                LOGGER.warn("Proof file not deleted (will be swept as an orphan): {}", account.proof.file, e);
+            }
+        }
+    }
+
+    /**
+     * Removes the accounts of users that no longer exist and any receipt file nobody refers to (LGPD: nothing is
+     * kept for deleted customers).
+     */
+    public synchronized void purgeOrphans(java.util.Set<Long> existingUserIds) {
+        boolean changed = false;
+        var it = data.accounts.entrySet().iterator();
+        while (it.hasNext()) {
+            var entry = it.next();
+            boolean gone;
+            try {
+                gone = !existingUserIds.contains(Long.parseLong(entry.getKey()));
+            } catch (NumberFormatException e) {
+                gone = true;
+            }
+            if (gone) {
+                deleteProofFile(entry.getValue());
+                it.remove();
+                changed = true;
+            }
+        }
+        if (data.notices.keySet().removeIf(k -> !data.accounts.containsKey(k))) {
+            changed = true;
+        }
+        try {
+            if (Files.isDirectory(proofDir)) {
+                var referenced = new java.util.HashSet<String>();
+                data.accounts.values().forEach(a -> {
+                    if (a.proof != null) {
+                        referenced.add(a.proof.file);
+                    }
+                });
+                try (var files = Files.list(proofDir)) {
+                    for (var path : (Iterable<Path>) files::iterator) {
+                        if (!referenced.contains(path.getFileName().toString())) {
+                            Files.deleteIfExists(path);
+                        }
+                    }
+                }
+            }
+        } catch (IOException e) {
+            LOGGER.warn("Orphan receipts sweep failed", e);
+        }
+        if (changed) {
+            save();
+        }
+    }
+
+    // --- notices: stored here (only their owner can read them), never in tc_events -----------------------
+
+    /** Keeps a notice for 7 days so a phone that was offline still gets it. Returns its id. */
+    public synchronized String addNotice(long userId, String kind, String message) {
+        var list = data.notices.computeIfAbsent(String.valueOf(userId), k -> new ArrayList<>());
+        var cutoff = java.time.Instant.now().minus(java.time.Duration.ofDays(7));
+        list.removeIf(n -> java.time.Instant.parse(n.createdAt).isBefore(cutoff));
+        var notice = new Notice();
+        notice.id = UUID.randomUUID().toString().substring(0, 12);
+        notice.kind = kind;
+        notice.message = message;
+        notice.createdAt = java.time.Instant.now().toString();
+        list.add(notice);
+        while (list.size() > 30) {
+            list.remove(0);
+        }
+        save();
+        return notice.id;
+    }
+
+    public synchronized List<Notice> notices(long userId) {
+        var list = data.notices.get(String.valueOf(userId));
+        if (list == null) {
+            return List.of();
+        }
+        var cutoff = java.time.Instant.now().minus(java.time.Duration.ofDays(7));
+        var result = new ArrayList<Notice>();
+        for (var n : list) {
+            if (!java.time.Instant.parse(n.createdAt).isBefore(cutoff)) {
+                result.add(n);
+            }
+        }
+        return result;
+    }
+
+    /** Stores the receipt (replacing a previous one). The account must already exist with a due date. */
+    public synchronized Account saveProof(long userId, byte[] bytes, String name, String type) throws IOException {
+        var account = data.accounts.get(String.valueOf(userId));
+        if (account == null || account.dueDate == null) {
+            throw new IllegalStateException("no billing");
+        }
+        Files.createDirectories(proofDir);
+        deleteProofFile(account);
+        var proof = new Proof();
+        String ext = type.equals("application/pdf") ? "pdf" : type.equals("image/png") ? "png"
+                : type.equals("image/webp") ? "webp" : "jpg";
+        proof.file = userId + "-" + System.currentTimeMillis() + "." + ext;
+        String clean = name == null ? "" : name.replaceAll("[^\\p{L}\\p{N} ._-]", "_").trim();
+        proof.name = clean.isEmpty() ? "comprovante." + ext : clean.substring(0, Math.min(clean.length(), 80));
+        proof.type = type;
+        proof.size = bytes.length;
+        proof.uploadedAt = java.time.Instant.now().toString();
+        Files.write(proofDir.resolve(proof.file), bytes);
+        account.proof = proof;
+        save();
+        return copy(account);
+    }
+
+    public synchronized Proof proof(long userId) {
+        var account = data.accounts.get(String.valueOf(userId));
+        return account == null ? null : account.proof;
+    }
+
+    public synchronized byte[] proofBytes(long userId) throws IOException {
+        var proof = proof(userId);
+        if (proof == null) {
+            return null;
+        }
+        var path = proofDir.resolve(proof.file);
+        return Files.exists(path) ? Files.readAllBytes(path) : null;
+    }
+
+    public synchronized Account removeProof(long userId) {
+        var account = data.accounts.get(String.valueOf(userId));
+        if (account == null) {
+            return null;
+        }
+        deleteProofFile(account);
+        account.proof = null;
+        save();
+        return copy(account);
+    }
+
+    public synchronized void noticeSent(long userId) {
+        var account = data.accounts.get(String.valueOf(userId));
+        if (account != null) {
+            account.lastNotice = java.time.Instant.now().toString();
+            save();
+        }
+    }
+
+    /** The day the customer pays on is kept: 31/01 -> 28/02 -> 31/03 (not 28/03). anchorDay 0 = use the date's day. */
+    public static LocalDate addMonths(LocalDate date, int months, int anchorDay) {
+        var month = java.time.YearMonth.from(date).plusMonths(months);
+        int day = anchorDay > 0 ? anchorDay : date.getDayOfMonth();
+        return month.atDay(Math.min(day, month.lengthOfMonth()));
+    }
+
+    private static String checkPaidOn(String paidOn) {
+        var date = LocalDate.parse(paidOn);
+        if (date.getYear() < 2020 || date.isAfter(today().plusDays(1))) {
+            throw new IllegalArgumentException("invalid paidOn");
+        }
+        return date.toString();
+    }
+
+    private Account copy(Account source) {
+        if (source == null) {
+            return null;
+        }
+        var copy = new Account();
+        copy.dueDate = source.dueDate;
+        copy.amount = source.amount;
+        copy.lastNotice = source.lastNotice;
+        copy.payLink = source.payLink;
+        copy.anchorDay = source.anchorDay;
+        copy.pixCode = source.pixCode;
+        copy.proof = source.proof;
+        copy.payments = new ArrayList<>(source.payments);
+        return copy;
+    }
+
+}
