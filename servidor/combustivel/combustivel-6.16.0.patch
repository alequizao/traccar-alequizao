+/*
+ * Módulo de preços de combustível · Desenvolvido por Alequizao <alequizao.dev@gmail.com>
+ * Dados: SEFAZ-AL, programa Economiza Alagoas. Licença Apache 2.0, como o Traccar.
+ */
+package org.traccar.api.resource;
+
+import jakarta.annotation.security.PermitAll;
+import jakarta.inject.Inject;
+import jakarta.ws.rs.DefaultValue;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.WebApplicationException;
+import jakarta.ws.rs.core.MediaType;
+import jakarta.ws.rs.core.Response;
+import org.traccar.api.BaseResource;
+import org.traccar.fuel.FuelService;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+@Path("fuel")
+@Produces(MediaType.APPLICATION_JSON)
+public class FuelResource extends BaseResource {
+
+    @Inject
+    private FuelService fuelService;
+
+    /**
+     * Cheapest stations around a point, e.g. GET /api/fuel?latitude=-9.65&amp;longitude=-35.7&amp;radius=3&amp;type=1
+     */
+    @PermitAll // public SEFAZ data, no personal information
+    @GET
+    public Map<String, Object> nearby(
+            @QueryParam("latitude") Double latitude,
+            @QueryParam("longitude") Double longitude,
+            @QueryParam("radius") @DefaultValue("5") double radius,
+            @QueryParam("type") @DefaultValue("1") int type,
+            @QueryParam("limit") @DefaultValue("5") int limit) {
+        if (!fuelService.isEnabled() || fuelService.getUpdatedAt() == null) {
+            throw new WebApplicationException(Response.status(Response.Status.SERVICE_UNAVAILABLE)
+                    .entity(Map.of("error", "fuel prices not available yet")).build());
+        }
+        if (latitude == null || longitude == null || type < 1 || type > 6 || !Double.isFinite(radius)
+                || !Double.isFinite(latitude) || !Double.isFinite(longitude)) {
+            throw new WebApplicationException(Response.status(Response.Status.BAD_REQUEST).build());
+        }
+        var result = new LinkedHashMap<String, Object>();
+        result.put("type", type);
+        result.put("radius", Math.min(Math.max(radius, 0.1), 30));
+        result.put("updatedAt", fuelService.getUpdatedAt().toString());
+        result.put("stations", fuelService.nearby(latitude, longitude,
+                Math.min(Math.max(radius, 0.1), 30), type, Math.min(Math.max(limit, 1), 50)));
+        return result;
+    }
+
+    /**
+     * Nearest stations with every fuel price (public, no login), e.g. GET /api/fuel/stations?latitude=-9.65&amp;longitude=-35.7&amp;radius=6
+     */
+    @PermitAll // public SEFAZ data, no personal information; lets apps without a Traccar login (RS Cliente) use it
+    @GET
+    @Path("stations")
+    public Map<String, Object> stations(
+            @QueryParam("latitude") Double latitude,
+            @QueryParam("longitude") Double longitude,
+            @QueryParam("radius") @DefaultValue("6") double radius,
+            @QueryParam("limit") @DefaultValue("40") int limit) {
+        if (!fuelService.isEnabled() || fuelService.getUpdatedAt() == null) {
+            throw new WebApplicationException(Response.status(Response.Status.SERVICE_UNAVAILABLE)
+                    .entity(Map.of("error", "fuel prices not available yet")).build());
+        }
+        if (latitude == null || longitude == null || !Double.isFinite(radius)
+                || !Double.isFinite(latitude) || !Double.isFinite(longitude)) {
+            throw new WebApplicationException(Response.status(Response.Status.BAD_REQUEST).build());
+        }
+        var result = new LinkedHashMap<String, Object>();
+        result.put("updatedAt", fuelService.getUpdatedAt().toString());
+        result.put("stations", fuelService.stationsAround(latitude, longitude,
+                Math.min(Math.max(radius, 0.1), 30), Math.min(Math.max(limit, 1), 100)));
+        return result;
+    }
+
+}
